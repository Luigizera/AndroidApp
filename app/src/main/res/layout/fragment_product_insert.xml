<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSecondary"
    tools:context=".fragments.ProductInsertFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" >

        <TextView
            android:id="@+id/fragment_product_insert_textview_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:padding="0dp"
            android:text="@string/sample_text"
            android:textColor="?attr/colorError"
            android:textSize="20sp"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/fragment_product_insert_textview_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:ems="10"
            android:text="@string/text_product_name"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toTopOf="@+id/fragment_product_insert_edittext_name"
            app:layout_constraintStart_toStartOf="parent" />
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/fragment_product_insert_edittext_name"
            android:autofillHints="@string/hint_product_name"
            android:inputType="textMultiLine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="48dp"
            android:hint="@string/hint_product_name"
            android:textColorHint="?attr/colorPrimary"
            android:textColor="?attr/colorPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_product_insert_textview_error" />

        <TextView
            android:id="@+id/fragment_product_insert_textview_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:ems="10"
            android:text="@string/text_product_description"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toTopOf="@+id/fragment_product_insert_edittext_description"
            app:layout_constraintStart_toStartOf="parent" />
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/fragment_product_insert_edittext_description"
            android:autofillHints="@string/hint_product_description"
            android:inputType="textMultiLine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="@string/hint_product_description"
            android:textColorHint="?attr/colorPrimary"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="48dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            app:backgroundTint="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_product_insert_edittext_name" />

        <TextView
            android:id="@+id/fragment_product_insert_textview_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:ems="10"
            android:text="@string/text_product_price"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toTopOf="@+id/fragment_product_insert_edittext_price"
            app:layout_constraintStart_toStartOf="parent" />
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/fragment_product_insert_edittext_price"
            android:autofillHints="@string/hint_product_price"
            android:inputType="numberDecimal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="@string/hint_product_price"
            android:textColorHint="?attr/colorPrimary"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="48dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            app:backgroundTint="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_product_insert_edittext_description" />

        <TextView
            android:id="@+id/fragment_product_insert_textview_purchase_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:ems="10"
            android:text="@string/text_product_purchase_price"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toTopOf="@+id/fragment_product_insert_edittext_purchase_price"
            app:layout_constraintStart_toStartOf="parent" />
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/fragment_product_insert_edittext_purchase_price"
            android:autofillHints="@string/hint_product_purchase_price"
            android:inputType="numberDecimal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="@string/hint_product_purchase_price"
            android:textColorHint="?attr/colorPrimary"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="48dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            app:backgroundTint="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_product_insert_edittext_price" />

        <TextView
            android:id="@+id/fragment_product_insert_textview_min_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:ems="10"
            android:text="@string/text_product_min_stock"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toTopOf="@+id/fragment_product_insert_edittext_min_stock"
            app:layout_constraintStart_toStartOf="parent" />
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/fragment_product_insert_edittext_min_stock"
            android:autofillHints="@string/hint_product_min_stock"
            android:inputType="number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="@string/hint_product_min_stock"
            android:textColorHint="?attr/colorPrimary"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="48dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            app:backgroundTint="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_product_insert_edittext_purchase_price" />


        <TextView
            android:id="@+id/fragment_product_insert_textview_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:ems="10"
            android:text="@string/text_product_category"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toTopOf="@+id/fragment_product_insert_button_select_categories"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/fragment_product_insert_button_select_categories"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="48dp"
            android:text="@string/select_categories"
            android:textColor="?attr/colorSecondary"
            android:backgroundTint="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_product_insert_edittext_min_stock" />

        <TextView
            android:id="@+id/fragment_product_insert_textview_selected_categories"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="8dp"
            android:text="@string/no_categories_selected"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_product_insert_button_select_categories" />

        <ImageButton
            android:id="@+id/fragment_product_insert_submitbutton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="end|bottom"
            android:layout_margin="16dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/rounded_background"
            android:backgroundTint="?attr/colorPrimary"
            android:contentDescription="@string/submit_button"
            android:scaleType="center"
            android:src="@drawable/baseline_done_24"
            app:tint="?attr/colorSecondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_product_insert_textview_selected_categories" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>